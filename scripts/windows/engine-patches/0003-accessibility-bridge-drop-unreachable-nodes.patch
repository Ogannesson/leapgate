+// While the bridge waits for the complete tree after a failed update, the
+// framework sends one that contains a node that no node lists. The bridge
+// drops that node and stops waiting.
+TEST(AccessibilityBridgeTest, RecoversFromCompleteTreeWithUnreachableNode) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+  bridge->SetFullTreeRequestIntervalForTesting(fml::TimeDelta::FromSeconds(60));
+  PopulateReparentingTree(*bridge);
+
+  std::vector<int32_t> node2_children{7};
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(2, "node 2", &node2_children));
+  bridge->CommitUpdates();
+  EXPECT_EQ(bridge->full_tree_requests, 1);
+  EXPECT_EQ(bridge->GetRootAsAXNode()->id(), ui::AXNode::kInvalidAXID);
+
+  std::vector<int32_t> node0_children{1, 2, 5};
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(0, "node 0", &node0_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "node 1"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(2, "node 2"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(5, "node 5"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(9, "node 9"));
+  bridge->CommitUpdates();
+
+  EXPECT_EQ(bridge->GetRootAsAXNode()->id(), 0);
+  EXPECT_FALSE(bridge->GetFlutterPlatformNodeDelegateFromID(5).expired());
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(9).expired());
+  EXPECT_EQ(bridge->full_tree_requests, 1);
+
+  // The wait is over: an update without the root is applied.
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "node 1 new"));
+  bridge->CommitUpdates();
+  auto node1 = bridge->GetFlutterPlatformNodeDelegateFromID(1).lock();
+  ASSERT_TRUE(node1);
+  EXPECT_EQ(node1->GetName(), "node 1 new");
+}
