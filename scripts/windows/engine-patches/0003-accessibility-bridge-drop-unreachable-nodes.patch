+void AccessibilityBridge::DropUnreachableNodes() {
+  // ui::AXTree rejects a whole update if any node in it cannot be reached
+  // from the root. The framework sends such nodes: an OverlayPortal anchor
+  // merged into its parent is sent although the parent lists no children
+  // (fixed by flutter/flutter#186118), and overlay content is sent under an
+  // anchor that is not sent (flutter/flutter#190357, flutter/flutter#182444,
+  // partly fixed by flutter/flutter#193372). The complete tree that
+  // ResetAfterFailedUpdate asks for contains them again, so the tree would
+  // stay empty. Dropping them keeps the rest of the tree.
+  AccessibilityNodeId root_id = GetRootAsAXNode()->id();
+  // A tree whose root is some other node was built from an update without the
+  // framework's root (see RequestFullSemanticsTree). Its root is wrong, so
+  // dropping node 0 as unreachable would keep it; leave such updates to fail
+  // and rebuild the tree.
+  if (root_id != ui::AXNode::kInvalidAXID && root_id != kFrameworkRootId) {
+    return;
+  }
+  if (root_id == ui::AXNode::kInvalidAXID) {
+    if (pending_semantics_node_updates_.find(kFrameworkRootId) ==
+        pending_semantics_node_updates_.end()) {
+      return;
+    }
+    root_id = kFrameworkRootId;
+  }
+
+  // Such nodes are new and listed by no parent. Look for those first, so
+  // that the usual update does not walk the whole tree.
+  std::unordered_set<AccessibilityNodeId> listed;
+  for (const auto& [id, node] : pending_semantics_node_updates_) {
+    listed.insert(node.children_in_traversal_order.begin(),
+                  node.children_in_traversal_order.end());
+  }
+  bool has_unlisted_new_node = false;
+  for (const auto& [id, node] : pending_semantics_node_updates_) {
+    if (id != root_id && listed.find(id) == listed.end() &&
+        !tree_->GetFromId(id)) {
+      has_unlisted_new_node = true;
+      break;
+    }
+  }
+  if (!has_unlisted_new_node) {
+    return;
+  }
+
+  // Walk the tree as it will be after the update: a pending node has its new
+  // children, any other node keeps its current ones.
+  std::unordered_set<AccessibilityNodeId> reached{root_id};
+  std::vector<AccessibilityNodeId> to_visit{root_id};
+  while (!to_visit.empty()) {
+    AccessibilityNodeId id = to_visit.back();
+    to_visit.pop_back();
+    const std::vector<int32_t>* children = nullptr;
+    auto pending = pending_semantics_node_updates_.find(id);
+    if (pending != pending_semantics_node_updates_.end()) {
+      children = &pending->second.children_in_traversal_order;
+    } else if (ui::AXNode* node = tree_->GetFromId(id)) {
+      children = &node->data().child_ids;
+    } else {
+      continue;
+    }
+    for (int32_t child : *children) {
+      if (reached.insert(child).second) {
+        to_visit.push_back(child);
+      }
+    }
+  }
+
+  std::vector<AccessibilityNodeId> dropped;
+  for (auto iter = pending_semantics_node_updates_.begin();
+       iter != pending_semantics_node_updates_.end();) {
+    if (reached.find(iter->first) == reached.end()) {
+      dropped.push_back(iter->first);
+      iter = pending_semantics_node_updates_.erase(iter);
+    } else {
+      ++iter;
+    }
+  }
+  std::sort(dropped.begin(), dropped.end());
+  std::string ids;
+  for (AccessibilityNodeId id : dropped) {
+    ids += (ids.empty() ? "" : ", ") + std::to_string(id);
+  }
+  FML_LOG(ERROR) << "Accessibility bridge dropped semantics nodes unreachable "
+                 << "from root " << root_id << ": " << ids;
+}
