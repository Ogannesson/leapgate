+  std::vector<int32_t> node3_children{4};
+  std::vector<int32_t> node9_children{10};
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(5, "node 5", &node5_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(7, "node 7"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "node 1"));
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(2, "node 2", &node2_children));
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(3, "node 3", &node3_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(4, "node 4"));
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(9, "node 9", &node9_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(10, "node 10"));
+  bridge->CommitUpdates();
+
+  EXPECT_EQ(bridge->full_tree_requests, 0);
+  auto node3 = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+  auto node4 = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
