+  EXPECT_EQ(node7->GetAXNode()->parent()->id(), 5);
+  EXPECT_EQ(node3->GetAXNode()->parent()->id(), 2);
+  EXPECT_EQ(node4->GetAXNode()->parent()->id(), 3);
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(9).expired());
