+// The first tree contains nodes that no node lists: node 3, and node 4 with its
+// child 5, as the framework sends for an OverlayPortal anchor that was merged
+// into its parent. They are dropped and the rest of the tree is applied.
+TEST(AccessibilityBridgeTest, DropsUnreachableNodesFromCompleteTree) {
+  fml::testing::LogCapture log_capture;
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+
+  std::vector<int32_t> node0_children{1, 2};
+  std::vector<int32_t> node4_children{5};
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(0, "node 0", &node0_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "node 1"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(2, "node 2"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(3, "node 3"));
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(4, "node 4", &node4_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(5, "node 5"));
+  bridge->CommitUpdates();
+
+  EXPECT_EQ(bridge->GetRootAsAXNode()->id(), 0);
+  auto root = bridge->GetFlutterPlatformNodeDelegateFromID(0).lock();
+  ASSERT_TRUE(root);
+  EXPECT_EQ(root->GetChildCount(), 2);
+  EXPECT_FALSE(bridge->GetFlutterPlatformNodeDelegateFromID(1).expired());
+  EXPECT_FALSE(bridge->GetFlutterPlatformNodeDelegateFromID(2).expired());
+  for (int32_t id = 3; id <= 5; id++) {
+    EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(id).expired())
+        << "node " << id;
+  }
+  EXPECT_EQ(bridge->full_tree_requests, 0);
+  EXPECT_EQ(log_capture.str().find("rebuilt after failed update"),
+            std::string::npos)
+      << log_capture.str();
+  EXPECT_NE(log_capture.str().find("dropped semantics nodes unreachable from "
+                                   "root 0: 3, 4, 5"),
+            std::string::npos)
+      << log_capture.str();
+}
