+// If the complete tree cannot be requested, the bridge does not wait for it:
+// the next update is applied as the first update would be, which makes its
+// first node the root.
+TEST(AccessibilityBridgeTest, AppliesNextUpdateIfFullTreeCannotBeRequested) {
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
