+      std::make_shared<TestAccessibilityBridge>();
+  PopulateReparentingTree(*bridge);
+  auto stale_node4 = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
+  ASSERT_TRUE(stale_node4);
