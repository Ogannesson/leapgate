+  EXPECT_EQ(bridge->GetRootAsAXNode()->id(), 0);
+  auto node2 = bridge->GetFlutterPlatformNodeDelegateFromID(2).lock();
+  auto node3 = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+  ASSERT_TRUE(node2);
+  ASSERT_TRUE(node3);
+  EXPECT_EQ(node3->GetAXNode()->parent()->id(), 2);
+  EXPECT_EQ(node2->GetChildCount(), 1);
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(6).expired());
+  EXPECT_FALSE(bridge->accessibility_events.empty());
