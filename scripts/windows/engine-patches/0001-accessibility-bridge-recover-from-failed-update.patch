+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(2, "node 2", &node2_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(3, "node 3"));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(4, "node 4"));
+  bridge->AddFlutterSemanticsNodeUpdate(
