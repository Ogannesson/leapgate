+// drops node 3, node 2 claims it and node 5 drops node 6, without sending
+// nodes 3 and 4. Applying it used to leave delegates that pointed at freed
+// nodes and a tree that refused every later update.
+TEST(AccessibilityBridgeTest, RecoversFromUpdateThatMovesUnsentNode) {
+  fml::testing::LogCapture log_capture;
+  std::shared_ptr<TestAccessibilityBridge> bridge =
+      std::make_shared<TestAccessibilityBridge>();
+  bridge->SetFullTreeRequestIntervalForTesting(fml::TimeDelta::FromSeconds(60));
+  PopulateReparentingTree(*bridge);
+  ui::AXTreeID tree_id = bridge->GetTreeID();
+  auto stale_node3 = bridge->GetFlutterPlatformNodeDelegateFromID(3).lock();
+  auto stale_node6 = bridge->GetFlutterPlatformNodeDelegateFromID(6).lock();
+  ASSERT_TRUE(stale_node3);
+  ASSERT_TRUE(stale_node6);
+
+  std::vector<int32_t> node2_children{3};
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(1, "node 1"));
+  bridge->AddFlutterSemanticsNodeUpdate(
+      CreateSemanticsNode(2, "node 2", &node2_children));
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(5, "node 5"));
+  bridge->CommitUpdates();
+
+  EXPECT_NE(log_capture.str().find("bridge rebuilt after failed update"),
+            std::string::npos);
+  EXPECT_EQ(bridge->full_tree_requests, 1);
+  // The bridge dropped every delegate and holds an empty tree.
+  for (int32_t id = 0; id <= 6; id++) {
+    EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(id).expired())
+        << "node " << id;
+  }
+  EXPECT_EQ(bridge->GetRootAsAXNode()->id(), ui::AXNode::kInvalidAXID);
+  EXPECT_EQ(bridge->RootDelegate(), nullptr);
+  EXPECT_EQ(bridge->GetTreeID(), tree_id);
+  EXPECT_EQ(ui::AXTreeManagerMap::GetInstance().GetManager(tree_id),
+            static_cast<ui::AXTreeManager*>(bridge.get()));
+  // Delegates that outlived the tree are safe to query.
+  ExpectDetached(stale_node3);
+  ExpectDetached(stale_node6);
+
+  // An update against the discarded tree is dropped, and the complete tree is
+  // not asked for again this soon.
+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(5, "node 5 new"));
+  bridge->CommitUpdates();
+  EXPECT_TRUE(bridge->GetFlutterPlatformNodeDelegateFromID(5).expired());
+  EXPECT_EQ(bridge->full_tree_requests, 1);
