+  bridge->AddFlutterSemanticsNodeUpdate(CreateSemanticsNode(4, "node 4 new"));
+  bridge->CommitUpdates();
+  auto node4 = bridge->GetFlutterPlatformNodeDelegateFromID(4).lock();
+  ASSERT_TRUE(node4);
+  EXPECT_EQ(node4->GetName(), "node 4 new");
+  EXPECT_EQ(bridge->full_tree_requests, 1);
