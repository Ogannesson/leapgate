+bool FlutterWindowsEngine::RequestFullSemanticsTree() {
+  if (!engine_ || !semantics_enabled_) {
+    return false;
+  }
+  // The embedder API has no call for this. Turning semantics off and on makes
+  // the framework dispose its SemanticsOwner and create a new one, which sends
+  // the complete tree with the next frame. Only the framework is toggled: the
+  // views keep their accessibility bridges, and a bridge that did not ask
+  // applies the complete tree like any other update.
+  //
+  // The caller is inside a semantics update callback, which with merged
+  // platform and UI threads runs inside the framework's frame, so the toggle
+  // must not run the framework's handlers synchronously.
+  task_runner_->PostTask([this]() {
+    if (!engine_ || !semantics_enabled_) {
+      return;
+    }
+    embedder_api_.UpdateSemanticsEnabled(engine_, false);
+    embedder_api_.UpdateSemanticsEnabled(engine_, true);
+  });
+  return true;
+}
